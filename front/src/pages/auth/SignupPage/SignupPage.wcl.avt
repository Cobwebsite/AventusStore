import { Page, type PageConfig } from "Aventus@UI:Aventus.Navigation.package.avt";
import { Main } from "../../../Main/Main.wcl.avt";
import { Required } from "Aventus@UI:Aventus.Form.Validators.package.avt";
import { Toast } from "../../../components/interaction/Toast/Toast.wcl.avt";
import { AuthSignupController } from "../../../../generated/app/Http/Controllers/Auth/Signup/Controller.lib.avt";
import { FormHandlerController } from "Aventus@UI:Aventus.Form.package.avt";


export class SignupPage extends Page implements Aventus.DefaultComponent {

    //#region static

    //#endregion


    //#region props

    //#endregion


    //#region variables
    private form: FormHandlerController<AuthSignupController>;
    //#endregion


    //#region constructor
    public constructor() {
        super();
        this.form = FormHandlerController.create(AuthSignupController, {
            email: Required,
            password: Required,
            username: Required
        }, {
            onSuccess: () => {
                this.form.item = {
                    email: "",
                    password: "",
                    username: ""
                };
                Toast.add({
                    type: "success",
                    title: "Account created",
                    message: "Check your mail to validate your account"
                });
                this.router?.navigate("/login");
            }
        });
    }
    //#endregion


    //#region methods

    /**
     * @inheritdoc
     */
    public override configure(): Aventus.Asyncable<PageConfig> {
        return {};
    }
    /**
     * @inheritdoc
     */
    public override isAllowed(state: Aventus.State): Aventus.Asyncable<boolean | Aventus.State | string> {
        if(Main.user) {
            return "/";
        }
        return true;
    }

    //#endregion

}