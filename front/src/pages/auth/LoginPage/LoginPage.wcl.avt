import { Page, type PageConfig } from "Aventus@UI:Aventus.Navigation.package.avt";
import { Required } from "Aventus@UI:Aventus.Form.Validators.package.avt";
import { Main } from "../../../Main/Main.wcl.avt";
import { Alert } from "../../../components/interaction/Alert/Alert.wcl.avt";
import { AuthLoginController } from "../../../../generated/app/Http/Controllers/Auth/Login/Controller.lib.avt";
import { FormHandlerController } from "Aventus@UI:Aventus.Form.package.avt";


export class LoginPage extends Page implements Aventus.DefaultComponent {

    //#region static

    //#endregion


    //#region props

    //#endregion


    //#region variables
    @Watch()
    public error?: string;
    @Watch()
    public isLoading?: boolean;

    private form: FormHandlerController<AuthLoginController>;
    //#endregion


    //#region constructor
    public constructor() {
        super();
        this.form = FormHandlerController.create(AuthLoginController, {
            username: Required,
            password: Required
        }, {
            onSuccess: (result) => {
                if(result) {
                    localStorage.setItem("token", result);
                    window.location.href = "/";
                }
            },
            onServerFallback: (errors) => {
                if(errors.some(p => p.code == 422)) {
                    this.error = "Wrong credentials";
                }
                else {
                    let msg = errors.map(p => p.message.replace(/\n/g, '<br/>')).join("<br/>");
                    Alert.open({
                        title: "Execution error",
                        content: msg,
                    });
                }
            }
        });
    }
    //#endregion


    //#region methods

    /**
     * @inheritdoc
     */
    public override configure(): Aventus.Asyncable<PageConfig> {
        return {};
    }
    public override isAllowed(state: Aventus.State): Aventus.Asyncable<boolean | Aventus.State | string> {
        if(Main.user) {
            return "/";
        }
        return true;
    }


    /**
     * 
     */
    protected clearError() {
        this.error = undefined;
    }
    //#endregion

}